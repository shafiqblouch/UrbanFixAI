{
  "$comment": "Single source of design tokens (DS-01). `pnpm --filter @urbanfix/tokens build` generates tokens.css and tokens.ts. Every pair listed in `pairs` is contrast-checked against WCAG 2.1 AA by `pnpm test`.",
  "themes": {
    "light": {
      "bg": "#FFFFFF",
      "surface": "#F5F6FB",
      "surfaceRaised": "#FFFFFF",
      "border": "#8A8FB0",
      "text": "#1B1F3B",
      "textMuted": "#474C6B",
      "primary": "#4338CA",
      "onPrimary": "#FFFFFF",
      "primarySoft": "#E4E5FB",
      "onPrimarySoft": "#2E2793",
      "accent": "#FF7A66",
      "onAccent": "#1B1F3B",
      "link": "#3730A3",
      "focusRing": "#4338CA",
      "success": "#14532D", "successBg": "#DCFCE7",
      "warning": "#7C2D12", "warningBg": "#FEF3C7",
      "danger": "#991B1B", "dangerBg": "#FEE2E2",
      "info": "#1E3A8A", "infoBg": "#DBEAFE",
      "neutral": "#374151", "neutralBg": "#E5E7EB"
    },
    "dark": {
      "bg": "#0E1126",
      "surface": "#171A36",
      "surfaceRaised": "#1F2347",
      "border": "#5E65A0",
      "text": "#ECEEFB",
      "textMuted": "#B4B9DC",
      "primary": "#9AA0FF",
      "onPrimary": "#0E1126",
      "primarySoft": "#2A2F69",
      "onPrimarySoft": "#DADDFF",
      "accent": "#FF8F7D",
      "onAccent": "#0E1126",
      "link": "#B3B8FF",
      "focusRing": "#B3B8FF",
      "success": "#86EFAC", "successBg": "#14391F",
      "warning": "#FCD34D", "warningBg": "#47300A",
      "danger": "#FCA5A5", "dangerBg": "#4C1414",
      "info": "#93C5FD", "infoBg": "#14284F",
      "neutral": "#D1D5DB", "neutralBg": "#2B2F45"
    }
  },
  "pairs": [
    ["text", "bg"], ["text", "surface"], ["text", "surfaceRaised"],
    ["textMuted", "bg"], ["textMuted", "surface"],
    ["onPrimary", "primary"], ["onPrimarySoft", "primarySoft"], ["onAccent", "accent"],
    ["link", "bg"], ["link", "surface"], ["primary", "bg"],
    ["success", "successBg"], ["warning", "warningBg"], ["danger", "dangerBg"],
    ["info", "infoBg"], ["neutral", "neutralBg"]
  ],
  "uiPairs": [
    ["border", "bg", 3], ["focusRing", "bg", 3], ["focusRing", "surface", 3]
  ],
  "gradients": {
    "kpiIndigo": ["#4338CA", "#5A4FDD"],
    "kpiCoral": ["#BE3A25", "#C8452E"],
    "kpiTeal": ["#0F766E", "#188077"],
    "kpiAmber": ["#B45309", "#B8590B"]
  },
  "kpiTileText": "#FFFFFF",
  "font": {
    "latin": "Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "urdu": "'Noto Naskh Arabic', 'Noto Nastaliq Urdu', 'Jameel Noori Nastaleeq', system-ui, sans-serif",
    "urduNote": "Default is Naskh for small-size legibility; DS-03 compares it with Nastaliq on real low-end phones before this is final.",
    "size": { "xs": 12, "sm": 14, "md": 16, "lg": 18, "xl": 22, "xxl": 28 },
    "urduScale": 1.15,
    "lineHeight": 1.5,
    "urduLineHeight": 1.9
  },
  "space": [0, 4, 8, 12, 16, 24, 32, 48, 64],
  "radius": { "sm": 6, "md": 10, "lg": 16, "pill": 999 },
  "touchTarget": 48,
  "shadow": {
    "sm": "0 1px 2px rgba(14,17,38,0.10)",
    "md": "0 4px 12px rgba(14,17,38,0.14)",
    "lg": "0 12px 32px rgba(14,17,38,0.20)"
  }
}
