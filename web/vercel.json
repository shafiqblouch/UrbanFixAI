{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "corepack enable && corepack prepare pnpm@10.18.0 --activate && pnpm install --frozen-lockfile --filter @urbanfix/portal...",
  "buildCommand": "pnpm --filter @urbanfix/portal exec vite build",
  "outputDirectory": "apps/portal/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://urbanfix-core.onrender.com/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
