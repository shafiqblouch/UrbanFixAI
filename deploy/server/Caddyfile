# HTTPS for PUBLIC_HOST using the DigiCert wildcard certificate for *.vitonta.com,
# supplied by the hosting/network team and mounted read-only at /certs.
# We bind the cert explicitly instead of using ACME, because this provider's firewall
# blocks inbound 443 from Let's Encrypt's validators (ACME TLS-ALPN/HTTP challenges time out).
# /certs/fullchain.pem = leaf + intermediate;  /certs/privkey.key = matching EC private key.
# When the team rotates the cert, replace those two files and `docker compose restart caddy`.

# Portal, API and media all on the one origin — same host, cert and Cloudflare proxy as everything else,
# so NO separate media hostname, DNS record or port is needed (the custom port 9000 was never reachable).
{$PUBLIC_HOST} {
	tls /certs/fullchain.pem /certs/privkey.key

	# Complaint photos/audio: signed links live under the storage bucket path (/urbanfix-media/<key>) and go
	# straight to MinIO, with the path preserved. Signed for this same host, so MinIO's SigV4 Host check passes.
	# Keep this prefix in step with Storage__Bucket.
	@media path /urbanfix-media/*
	handle @media {
		reverse_proxy minio:9000
	}

	# Everything else is the portal: the web container serves the SPA and proxies /api to the core service.
	handle {
		reverse_proxy web:10000
	}
}
