# HTTPS for PUBLIC_HOST using the DigiCert wildcard certificate for *.vitonta.com,
# supplied by the hosting/network team and mounted read-only at /certs.
# We bind the cert explicitly instead of using ACME, because this provider's firewall
# blocks inbound 443 from Let's Encrypt's validators (ACME TLS-ALPN/HTTP challenges time out).
# /certs/fullchain.pem = leaf + intermediate;  /certs/privkey.key = matching EC private key.
# When the team rotates the cert, replace those two files and `docker compose restart caddy`.

# Portal + API on the main origin. The web container serves the SPA and proxies /api to the core service.
{$PUBLIC_HOST} {
	reverse_proxy web:10000
	tls /certs/fullchain.pem /certs/privkey.key
}

# Object storage on its own hostname (still port 443), because the provider firewall/Cloudflare does not
# forward custom ports like 9000. MEDIA_HOST must be a single-label subdomain of the wildcard cert's domain
# (e.g. urbanfix-media.vitonta.com — *.vitonta.com does NOT cover media.urbanfix.vitonta.com). Signed photo/audio
# links are generated for this host, and Caddy forwards the Host header unchanged so MinIO's SigV4 check passes.
{$MEDIA_HOST} {
	reverse_proxy minio:9000
	tls /certs/fullchain.pem /certs/privkey.key
}
