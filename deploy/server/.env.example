# Copy to .env on the server and fill in. Use long random values; letters and digits only avoids shell-quoting trouble.
# Generate secrets quickly:  openssl rand -hex 24

# The public hostname of this server. A real domain is best (e.g. urbanfix.example.com).
# IP only? Use <your.ip.add.ress>.sslip.io here (e.g. 203.0.113.9.sslip.io) and Caddy can still issue a real cert.
PUBLIC_HOST=

# Database
DB_PASSWORD=
APP_ROLE_PASSWORD=

# First admin account (created on startup)
ADMIN_EMAIL=admin@urbanfix.local
ADMIN_PASSWORD=

# Service-to-service token between the core API and the AI service (any long random string; must match on both)
AI_SERVICE_TOKEN=

# OpenRouter key for the AI service (triage, vision, speech)
OPENROUTER_API_KEY=

# Object storage (MinIO) credentials
STORAGE_ACCESS_KEY=urbanfixmedia
STORAGE_SECRET_KEY=

# Development = demo sign-in on (phone/email code 123456), fine for a test/UAT server.
# Set to Production for real auth (needs an SMS/TOTP provider configured) — see README.
CORE_ENVIRONMENT=Development

# Optional: Six Labors ImageSharp license key. Without it the API builds in Debug, which the license allows for testing.
SIXLABORS_LICENSE_KEY=
