# Copy to .env on the VM and fill in. Use long random values (letters and digits only avoids quoting problems).
# The Azure DNS name of the VM, e.g. urbanfix-test.westeurope.cloudapp.azure.com
PUBLIC_HOST=
DB_PASSWORD=
APP_ROLE_PASSWORD=
ADMIN_PASSWORD=
AI_SERVICE_TOKEN=
OPENROUTER_API_KEY=
STORAGE_ACCESS_KEY=urbanfixmedia
STORAGE_SECRET_KEY=
# Optional: Six Labors license key. Without it the API is built in Debug, which the license allows for testing.
SIXLABORS_LICENSE_KEY=
