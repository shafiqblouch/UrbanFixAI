{
  "expo": {
    "name": "UrbanFix",
    "slug": "urbanfix",
    "version": "0.1.0",
    "scheme": "urbanfix",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#059669"
    },
    "ios": {
      "icon": "./assets/icon.png"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "android": {
      "package": "pk.urbanfix.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#059669"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "usesCleartextTraffic": true
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#059669"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "UrbanFix uses the camera to take photos of problems and of finished work."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "UrbanFix records a voice note when you choose to describe a problem by voice."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "UrbanFix adds your location to a complaint or a job note when you ask it to."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1fc36666-5c8b-4b0a-a388-1b7c557b330e"
      }
    }
  }
}
